#!/usr/bin/env bash
# Personal fork installer for ChristopheAwad/opencode.
# Installs (or updates to) the latest `insecure-combined` CI build, which
# contains the insecure-origin image-attachment and code-copy fixes.
# This file lives on the `insecure-combined` branch only. It is never
# meant for the upstream project.
#
# Safety rule: the fork binary goes into its OWN folder
# (~/Downloads/opencode-test/opencode) and is run with a relative path
# (./opencode). It never touches ~/.opencode/bin, where the official
# release lives, so the two can never overwrite each other.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/ChristopheAwad/opencode/insecure-combined/install-fork | bash
# Re-run the same command at any time to update to the newest CI build.
#
# Run it with:
#   cd ~/Downloads/opencode-test && ./opencode web --hostname 0.0.0.0
set -euo pipefail

MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Personal OpenCode Installer (ChristopheAwad fork)

Usage: install-fork [options]

Options:
    -h, --help  Display this help message

Installs the fork binary to ~/Downloads/opencode-test/opencode.
Re-run to update to the newest CI build.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo -e "${RED}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

raw_os=$(uname -s)
arch=$(uname -m)
if [[ "$raw_os" != "Linux"* || "$arch" != "x86_64" ]]; then
    echo -e "${RED}Error: this personal build only supports Linux x64 (found: $raw_os/$arch).${NC}"
    echo -e "${MUTED}The CI workflow builds a single opencode-linux-x64 binary.${NC}"
    exit 1
fi

INSTALL_DIR=$HOME/Downloads/opencode-test
mkdir -p "$INSTALL_DIR"

url="https://github.com/ChristopheAwad/opencode/releases/download/personal-latest/opencode-linux-x64"

echo -e "${MUTED}Downloading personal build:${NC} $url"
tmp_file="${TMPDIR:-/tmp}/opencode-fork-download-$$"
curl -fsSL -o "$tmp_file" "$url"
chmod 755 "$tmp_file"
mv "$tmp_file" "$INSTALL_DIR/opencode"
echo -e "${MUTED}Installed to:${NC} $INSTALL_DIR/opencode"
echo -e ""
echo -e "${MUTED}The official release in ~/.opencode/bin was left alone.${NC}"
echo -e "${MUTED}Run the fork with:${NC} cd ~/Downloads/opencode-test && ./opencode web --hostname 0.0.0.0"
echo -e ""
